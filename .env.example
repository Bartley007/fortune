# Python algorithm services. The ports are intentionally separate because
# bazi_service and python_algorithm expose different API namespaces.
PYTHON_BAZI_BASE_URL=http://127.0.0.1:8001
PYTHON_DIVINATION_BASE_URL=http://127.0.0.1:8002

# Module 4 personal knowledge API used by the /library workspace.
NEXT_PUBLIC_MODULE4_API_BASE_URL=http://127.0.0.1:8003
NEXT_PUBLIC_MODULE4_USER_ID=dev-user

# Optional fallback for a single combined Python service exposing both
# /bazi/chart and /divination/cast. It is only used when the service-specific
# variables above are empty.
# PYTHON_ALGORITHM_BASE_URL=http://127.0.0.1:8000
